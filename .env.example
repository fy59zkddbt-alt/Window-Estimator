# Copy to .env.local and set your Supabase project URL and browser publishable key.
# Use only an sb_publishable_ key; never use secret/service-role/database credentials.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional HTTPS origin only, no path. Leave empty to use window.location.origin.
# Keep empty for Cloudflare branch previews so confirmation returns to that preview.
VITE_APP_ORIGIN=
